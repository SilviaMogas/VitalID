    "android": {
      "package": "site.vitalid.app",
      "versionCode": 1,
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "permissions": []
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization"
    ]
  }
}
