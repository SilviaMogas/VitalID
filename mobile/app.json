{
  "expo": {
    "name": "Vital ID",
    "slug": "vital-id-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "../public/icons/vitalid-512.png",
    "scheme": "vitalid",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "site.vitalid.app",
