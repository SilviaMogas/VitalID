{
  "name": "vital-id-native",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
