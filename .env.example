# --- Supabase (Vital ID) ---------------------------------------------------
# Client-safe (bundled into the browser). Not used by the share backend yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER import these in client components.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Share store backend: "supabase" | "memory". Leave empty for auto
# (supabase when SUPABASE_URL + SUPABASE_SECRET_KEY are set, otherwise memory).
SHARE_STORE=

# --- Stripe (LIVE mode; server-only except NEXT_PUBLIC_*) -------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time $1 USD demo prices (hackathon). Created by scripts/stripe-setup.mjs
STRIPE_PLUS_DEMO_PRICE_ID=
STRIPE_PRO_DEMO_PRICE_ID=
# Optional: public origin for Checkout return URLs (defaults to request origin)
NEXT_PUBLIC_APP_URL=
# Membership store: "supabase" | "memory" | empty=auto
MEMBERSHIP_STORE=
# Plan given to the Fatima demo user on first visit (free|plus|pro), default free
DEMO_DEFAULT_PLAN=

# --- WHOOP connector (server-only; never expose to the client) -------------
# From the WHOOP developer dashboard (https://developer.whoop.com).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Optional: exact OAuth redirect URI (must match the app registration).
# Defaults to ${NEXT_PUBLIC_APP_URL or request origin}/api/connectors/whoop/callback
WHOOP_REDIRECT_URI=
# Test-only overrides for a local mock (see scripts/whoop-mock-server.mjs)
WHOOP_OAUTH_BASE=    # default https://api.prod.whoop.com
WHOOP_API_BASE=      # default https://api.prod.whoop.com/developer
