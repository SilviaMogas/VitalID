# --- Supabase (Vital ID) ---------------------------------------------------
# Client-safe (bundled into the browser). Not used by the share backend yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER import these in client components.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Share store backend: "supabase" | "memory". Leave empty for auto
# (supabase when SUPABASE_URL + SUPABASE_SECRET_KEY are set, otherwise memory).
SHARE_STORE=

# --- Stripe (LIVE mode; server-only except NEXT_PUBLIC_*) -------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring subscription prices, one per plan + interval. Create them with
# scripts/stripe-setup.mjs (run it with a sk_test_ key first!).
# Each value may be a `price_…` id OR a `prod_…` product id (resolved via its
# default_price). Alternative product-id names also accepted:
# STRIPE_PRODUCT_{PLUS|PRO}_{MONTHLY|ANNUAL}.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Optional: public origin for Checkout return URLs (defaults to request origin)
NEXT_PUBLIC_APP_URL=
# Membership store: "supabase" | "memory" | empty=auto
MEMBERSHIP_STORE=
# Plan given to the Fatima demo user on first visit (free|plus|pro), default free
DEMO_DEFAULT_PLAN=
# Show the "Login as Fatima" instant demo on the welcome screen.
# OFF by default (production-safe). Set to 1 at build time to enable it — it
# gates both the welcome-screen entry point and the client-side demo session.
NEXT_PUBLIC_DEMO_LOGIN=

# --- Solana Pay (one-time SOL payments; server-only) -------------------------
# Wallet address that receives SOL membership payments (required to enable).
SOL_TREASURY_ADDRESS=
# Cluster for verification: devnet (default) | testnet | mainnet-beta
SOL_PAY_CLUSTER=
# Optional JSON-RPC override (defaults to the public cluster endpoint)
SOL_PAY_RPC=
# Payment request lifetime in minutes (default 60)
SOL_PAY_EXPIRY_MINUTES=
# Price per plan+interval in lamports (1 SOL = 1_000_000_000). Defaults are
# demo values — set real prices before enabling on mainnet-beta.
SOL_PAY_LAMPORTS_PLUS_MONTHLY=
SOL_PAY_LAMPORTS_PLUS_ANNUAL=
SOL_PAY_LAMPORTS_PRO_MONTHLY=
SOL_PAY_LAMPORTS_PRO_ANNUAL=
# Payment store: "supabase" | "memory" | empty=auto (mirrors MEMBERSHIP_STORE)
SOL_PAYMENT_STORE=

# --- WHOOP connector (server-only; never expose to the client) -------------
# From the WHOOP developer dashboard (https://developer.whoop.com).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Optional: exact OAuth redirect URI (must match the app registration).
# Several may be listed (comma/space separated); the one matching the request origin is used.
# Defaults to ${NEXT_PUBLIC_APP_URL or request origin}/api/connectors/whoop/callback
WHOOP_REDIRECT_URI=
# Test-only overrides for a local mock (see scripts/whoop-mock-server.mjs)
WHOOP_OAUTH_BASE=    # default https://api.prod.whoop.com
WHOOP_API_BASE=      # default https://api.prod.whoop.com/developer

# --- Oura connector (server-only) ------------------------------------------
# https://cloud.ouraring.com/oauth/applications — redirect URI:
#   <app origin>/api/connectors/wearables/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=

# --- Strava connector (server-only) ----------------------------------------
# https://www.strava.com/settings/api — "Authorization Callback Domain" = your domain
# redirect URI used: <app origin>/api/connectors/wearables/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
